e68edcb077b7cd1ab2c006eb773e1e03aac6f42cbf1cc9bbb205f0331fda1b8334a582806a411c94f5e65921bb361a6b7c3cf98ff40e4a8c75fc34f0d7aed95e  adbd.confd
bd14bf5e85333c564bf4c409054dbcd8a5d547951cc739cec4b660ca025acc02a321db9fb2a8f601c7d99ea67d460ca40ce3f975fb25c77f8fe7efd482afe996  adbd-usb-watch
"
