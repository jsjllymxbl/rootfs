#!/bin/sh
# 拔插 USB 后重启 adbd，重建 functionfs 实例；盯 VBUS 而非 UDC（避免自激）。
# 由 /etc/init.d/adbd 的 start_post/stop_post 启停。

POWER_SUPPLY=${POWER_SUPPLY:-/sys/class/power_supply/pm8921-usb/online}
ADBD_LOG=${ADBD_LOG:-/var/log/adbd.log}
PIDFILE=/run/adbd-usb-watch.pid
TICK=200000	# 采样间隔，单位 us

trap '' HUP

note() {
	echo "$(date '+%H:%M:%S') adbd-usb-watch: $*" >>"$ADBD_LOG" 2>/dev/null
}

tick() {
	usleep "$TICK" 2>/dev/null || sleep 1
}

# 单实例
if [ -f "$PIDFILE" ]; then
	pid=$(cat "$PIDFILE" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		note "already running as $pid, exit"
		exit 0
	fi
fi
echo $$ >"$PIDFILE"

if [ ! -r "$POWER_SUPPLY" ]; then
	note "no $POWER_SUPPLY, hotplug watchdog disabled"
	rm -f "$PIDFILE"
	exit 0
fi

prev=$(cat "$POWER_SUPPLY" 2>/dev/null)
note "started, USB=${prev:-?}"

while :; do
	tick
	cur=$(cat "$POWER_SUPPLY" 2>/dev/null)
	[ -z "$cur" ] && continue
	[ "$cur" = "$prev" ] && continue

	# 再确认一次，滤掉毛刺
	tick
	cur=$(cat "$POWER_SUPPLY" 2>/dev/null)
	[ -z "$cur" ] && continue
	[ "$cur" = "$prev" ] && continue
	prev=$cur

	if [ "$cur" != "1" ]; then
		note "cable removed"
		continue
	fi

	note "cable re-inserted, restarting adbd for a fresh functionfs instance"
	rm -f "$PIDFILE"
	if command -v setsid >/dev/null 2>&1; then
		setsid rc-service adbd restart >/dev/null 2>&1 &
	else
		rc-service adbd restart >/dev/null 2>&1 &
	fi
	exit 0
done
