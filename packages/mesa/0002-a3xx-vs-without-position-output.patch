Squashed from upstream commit 3d167c08 (MR !45743).  Independent of the
fd3_emit.c chain: a vertex shader without a position output must not leave
the hardware's position register undefined.

---
diff --git a/src/gallium/drivers/freedreno/a3xx/fd3_program.c b/src/gallium/drivers/freedreno/a3xx/fd3_program.c
--- a/src/gallium/drivers/freedreno/a3xx/fd3_program.c
+++ b/src/gallium/drivers/freedreno/a3xx/fd3_program.c
@@ -138,6 +138,13 @@
    constmode = ((vp->constlen + fp->constlen) > 256) ? 1 : 0;
 
    pos_regid = ir3_find_output_regid(vp, VARYING_SLOT_POS);
+   if (pos_regid == regid(63, 0)) {
+      /* hw dislikes when there is no position output, which can
+       * happen for transform-feedback vertex shaders.  Just tell
+       * the hw to use r0.x, with whatever random value is there:
+       */
+      pos_regid = regid(0, 0);
+   }
    posz_regid = ir3_find_output_regid(fp, FRAG_RESULT_DEPTH);
    psize_regid = ir3_find_output_regid(vp, VARYING_SLOT_PSIZ);
    if (fp->color0_mrt) {
diff --git a/src/freedreno/ci/freedreno-a306-fails.txt b/src/freedreno/ci/freedreno-a306-fails.txt
--- a/src/freedreno/ci/freedreno-a306-fails.txt
+++ b/src/freedreno/ci/freedreno-a306-fails.txt
@@ -465,7 +465,6 @@
 spec@glsl-1.40@execution@texturesize@vs-texturesize-isamplerbuffer,Fail
 spec@glsl-1.40@execution@texturesize@vs-texturesize-samplerbuffer,Fail
 spec@glsl-1.40@execution@texturesize@vs-texturesize-usamplerbuffer,Fail
-spec@glsl-1.40@execution@tf-no-position,Fail
 spec@glsl-es-3.00@execution@varying-struct-centroid_gles3,Fail
 spec@khr_texture_compression_astc@miptree-gl srgb-fp,Fail
 spec@khr_texture_compression_astc@miptree-gl srgb-fp@sRGB decode full precision,Fail
