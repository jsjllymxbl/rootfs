#!/sbin/openrc-run
# 设 WiFi 监管域（regulatory.db 在 initramfs，这里设国家码）
description="Wireless regulatory domain"

# 一次性任务，不设 command/pidfile，关机时 OpenRC 不会尝试停 daemon
: ${REGION:=CN}
_iw=/usr/sbin/iw

depend() {
	need localmount
}

start() {
	[ -x "$_iw" ] || { ewarn "regdom: $_iw missing, skipping"; return 0; }

	ebegin "regdom: reloading regulatory database"
	"$_iw" reg reload >/dev/null 2>&1
	eend $?

	sleep 1

	ebegin "regdom: setting region to $REGION"
	"$_iw" reg set "$REGION" >/dev/null 2>&1
	eend $? "iw reg set $REGION failed"
}
